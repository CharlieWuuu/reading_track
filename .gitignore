# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# claude code local settings
.claude/

# 開發紀錄、待辦、記憶，只留本機
/docs/*
# 視覺參考圖例外，要進版控
!/docs/refs/

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# eslint cache
.eslintcache

# 設計稿工作檔：只活在本機，不進版控
docs/design/
