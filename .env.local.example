# 複製成 .env.local 填實際值（不會進 git）

# Supabase 的連線字串。交易模式的 pooler，port 6543——
# 5432 是 session mode，一個客戶端佔住一條後端連線，很快就滿
DATABASE_URL=

# 直連（port 5432），只給 drizzle-kit 用：DDL 不能走 pooler
DIRECT_URL=

# Cloud Console > 憑證 > OAuth 用戶端 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud Console > 憑證 > API 金鑰。查書用，沒有的話 Google Books 那個來源會跳過
GOOGLE_BOOKS_API_KEY=

# 隨機字串，加密 session：openssl rand -base64 32
AUTH_SECRET=
