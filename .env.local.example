# 複製成 .env.local 填實際值（不會進 git）

# Cloud Console > 憑證 > OAuth 用戶端 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud Console > 憑證 > API 金鑰，給 Picker 用
NEXT_PUBLIC_GOOGLE_API_KEY=

# Cloud Console 首頁的專案編號（純數字），給 Picker setAppId 用
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# 隨機字串，加密 session：openssl rand -base64 32
AUTH_SECRET=

AUTH_URL=http://localhost:3000
