# 複製這個檔案為 .env.local，並填入實際值（.env.local 不會進 git）

# Google Cloud Console > 憑證 > OAuth 用戶端 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Console > 憑證 > API 金鑰（給 Google Picker 用，前端會用到，NEXT_PUBLIC 前綴會暴露給瀏覽器，屬正常用法）
NEXT_PUBLIC_GOOGLE_API_KEY=

# Cloud Console 首頁「專案資訊」的專案編號（純數字），給 Picker setAppId 用
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=750104401045

# NextAuth：任意隨機字串，用來加密 session。可用指令產生：openssl rand -base64 32
AUTH_SECRET=

AUTH_URL=http://localhost:3000
