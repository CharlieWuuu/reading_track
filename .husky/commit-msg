# Conventional Commits：type(scope)?: 描述
grep -qE '^(Merge |Revert )' "$1" && exit 0
grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+' "$1" && exit 0
echo "✗ commit 訊息格式錯誤"
echo "  需要：<type>(<scope>)?: <描述>"
echo "  type：feat fix docs style refactor perf test build ci chore revert"
echo "  例如：refactor: 共用 hook 移入 hooks/"
exit 1
