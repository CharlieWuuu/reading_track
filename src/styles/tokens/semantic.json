{
  "color": {
    "surface": {
      "$value": "{color.white}",
      "$type": "color",
      "$description": "頁面底色"
    },
    "surface-sunken": {
      "$value": "{color.neutral.100}",
      "$type": "color"
    },
    "surface-viz": {
      "$value": "{color.neutral.100}",
      "$type": "color",
      "$description": "圖表畫布，比頁面底色深一階才分得出圖與頁"
    },
    "surface-selected": {
      "$value": "{color.dune.300}",
      "$type": "color",
      "$description": "選取與大面積色塊；配色稿裡唯一拿來鋪底的暖色"
    },
    "ink": {
      "$value": "{color.neutral.900}",
      "$type": "color"
    },
    "ink-secondary": {
      "$value": "{color.neutral.700}",
      "$type": "color",
      "$description": "摘要與內文；比正文淡一階，還是拿來讀的"
    },
    "ink-muted": {
      "$value": "{color.neutral.500}",
      "$type": "color"
    },
    "ink-faint": {
      "$value": "{color.neutral.400}",
      "$type": "color",
      "$description": "meta 與全大寫小標籤"
    },
    "ink-viz": {
      "$value": "{color.neutral.900}",
      "$type": "color",
      "$description": "圖上的文字"
    },
    "ink-viz-muted": {
      "$value": "{color.neutral.500}",
      "$type": "color"
    },
    "ink-viz-faint": {
      "$value": "{color.neutral.400}",
      "$type": "color"
    },
    "accent": {
      "$value": "{color.cactus.700}",
      "$type": "color",
      "$description": "主色：主要動作鍵、選中的分頁、在讀那顆點。白底 5.9:1"
    },
    "accent-hover": {
      "$value": "{color.cactus.900}",
      "$type": "color"
    },
    "accent-ink": {
      "$value": "{color.white}",
      "$type": "color",
      "$description": "壓在主色上的字"
    },
    "rule": {
      "$value": "{color.neutral.200}",
      "$type": "color",
      "$description": "細線分隔，取代卡片框。1px"
    },
    "rule-soft": {
      "$value": "{color.neutral.100}",
      "$type": "color",
      "$description": "同一塊裡分列用；rule 是「這是兩個東西」，這一階是「同一件事的下一行」"
    },
    "rule-strong": {
      "$value": "{color.neutral.900}",
      "$type": "color",
      "$description": "區段小標下面那條實線與報頭雙線。1.4px／3px"
    },
    "shell-rule": {
      "$value": "{color.neutral.900}",
      "$type": "color",
      "$description": "外殼邊界（側欄右緣、報頭）。跟區段實線同色，畫的是版面骨架"
    },
    "grid": {
      "$value": "{color.neutral.200}",
      "$type": "color",
      "$description": "圖表格線；跟細分隔線同一階"
    },
    "series": {
      "1": {
        "$value": "{color.cactus.700}",
        "$type": "color"
      },
      "2": {
        "$value": "{color.dune.500}",
        "$type": "color"
      },
      "3": {
        "$value": "{color.sky.500}",
        "$type": "color"
      },
      "track": {
        "$value": "{color.neutral.100}",
        "$type": "color",
        "$description": "長條圖後面那條空軌"
      },
      "overflow": {
        "$value": "#b9b6ae",
        "$type": "color",
        "$description": "第 9 個以後合併成「其他」的那一格，不是第 9 個色；recharts 要字面值"
      }
    },
    "status": {
      "want": {
        "dot": {
          "$value": "{color.neutral.300}",
          "$type": "color",
          "$description": "狀態只靠一顆點的深淺：想讀最淡"
        }
      },
      "reading": {
        "dot": {
          "$value": "{color.accent}",
          "$type": "color",
          "$description": "在讀是唯一有彩度的一顆"
        }
      },
      "done": {
        "dot": {
          "$value": "{color.cactus.300}",
          "$type": "color"
        }
      }
    },
    "tag": {
      "domain": {
        "bg": {
          "$value": "{color.dune.300}",
          "$type": "color",
          "$description": "主領域：唯一鋪底的標籤"
        },
        "ink": {
          "$value": "{color.neutral.900}",
          "$type": "color"
        },
        "ring": {
          "$value": "{color.dune.500}",
          "$type": "color",
          "$description": "次領域改成底線版；同色系＝同一件事的粗細兩層"
        }
      },
      "platform": {
        "bg": {
          "$value": "{color.neutral.100}",
          "$type": "color"
        },
        "ink": {
          "$value": "{color.neutral.600}",
          "$type": "color"
        }
      },
      "type": {
        "ink": {
          "$value": "{color.neutral.600}",
          "$type": "color"
        },
        "ring": {
          "$value": "{color.neutral.300}",
          "$type": "color"
        }
      },
      "language": {
        "bg": {
          "$value": "{color.neutral.100}",
          "$type": "color"
        },
        "ink": {
          "$value": "{color.neutral.600}",
          "$type": "color"
        }
      },
      "article": {
        "bg": {
          "$value": "{color.neutral.100}",
          "$type": "color"
        },
        "ink": {
          "$value": "{color.neutral.500}",
          "$type": "color",
          "$description": "文章標籤是自由打的，沒有固定選項可配色，整組同一個中性色"
        }
      }
    },
    "danger": {
      "$value": "{color.brick.500}",
      "$type": "color",
      "$description": "錯誤與未完成"
    }
  },
  "font": {
    "serif": {
      "$value": "var(--font-noto-serif), Georgia, 'Songti TC', serif",
      "$type": "fontFamily",
      "$description": "值用襯線：書名、單字、數字、站名"
    },
    "sans": {
      "$value": "var(--font-noto-sans), 'PingFang TC', sans-serif",
      "$type": "fontFamily",
      "$description": "標籤與介面文字"
    }
  },
  "text": {
    "site": {
      "$value": "40px",
      "$type": "dimension",
      "$description": "報頭站名"
    },
    "lede": {
      "$value": "34px",
      "$type": "dimension",
      "$description": "頭條：一頁只有一個"
    },
    "page": {
      "$value": "30px",
      "$type": "dimension",
      "$description": "頁名"
    },
    "item": {
      "$value": "17px",
      "$type": "dimension",
      "$description": "主要條目"
    },
    "item-sm": {
      "$value": "15px",
      "$type": "dimension",
      "$description": "次要條目、側欄條目"
    },
    "note": {
      "$value": "14px",
      "$type": "dimension",
      "$description": "襯線摘要與引文"
    },
    "ui": {
      "$value": "13.5px",
      "$type": "dimension",
      "$description": "導覽項目、按鈕"
    },
    "byline": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "作者行"
    },
    "meta": {
      "$value": "11px",
      "$type": "dimension",
      "$description": "日期、計數"
    },
    "label": {
      "$value": "10.5px",
      "$type": "dimension",
      "$description": "全大寫小標籤"
    }
  },
  "tracking": {
    "label": {
      "$value": "0.16em",
      "$type": "dimension",
      "$description": "全大寫小標籤"
    },
    "section": {
      "$value": "0.12em",
      "$type": "dimension",
      "$description": "側欄分類標題"
    },
    "tight": {
      "$value": "-0.02em",
      "$type": "dimension",
      "$description": "站名與頭條"
    }
  },
  "stroke": {
    "hairline": {
      "$value": "1px",
      "$type": "dimension",
      "$description": "細線分隔"
    },
    "solid": {
      "$value": "1.4px",
      "$type": "dimension",
      "$description": "小標籤下面那條實線、報頭第二條"
    },
    "masthead": {
      "$value": "3px",
      "$type": "dimension",
      "$description": "報頭第一條"
    }
  },
  "radius": {
    "thumb": {
      "$value": "1px",
      "$type": "dimension",
      "$description": "書封、favicon、圖例色塊：報紙感要幾乎是直角"
    },
    "control": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "按鈕、輸入框、分頁列、標籤——版面靠線分，圓角會讓它們看起來像貼紙"
    },
    "surface": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "面板與浮層；細線分隔不用卡片框，所以也不需要圓角"
    }
  }
}
